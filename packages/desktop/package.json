{
  "name": "@x-code-cli/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop host for X-Code",
  "license": "MIT",
  "author": "X-Code contributors",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm build:main && pnpm build:renderer",
    "build:main": "node esbuild.config.mjs",
    "build:renderer": "vite build",
    "dev": "pnpm build && electron dist/main/index.cjs",
    "start": "electron dist/main/index.cjs",
    "smoke": "electron dist/main/index.cjs --smoke-test",
    "smoke:ui": "electron dist/main/index.cjs --ui-smoke",
    "package:dir": "pnpm build && electron-builder --dir",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json",
    "release:local": "node ../../scripts/release-desktop.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@vscode/ripgrep": "^1.17.0",
    "fs-ext-extra-prebuilt": "2.2.16",
    "node-pty": "^1.1.0",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0",
    "undici": "^7.28.0",
    "yauzl": "3.4.0"
  },
  "optionalDependencies": {
    "@fugood/whisper.node": "1.1.1",
    "@napi-audio/decoder": "0.1.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@x-code-cli/core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.0",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
