{
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:native": "pnpm --filter @x-code-cli/core run build:native",
    "dev": "pnpm -r run build && pnpm --filter @x-code-cli/cli run dev",
    "dev:desktop": "pnpm -r run build && pnpm --filter @x-code-cli/desktop run start",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && tsx packages/cli/tests/e2e/runner.ts",
    "test:coverage": "pnpm build && vitest run --coverage --project unit --project desktop --testTimeout=120000",
    "smoke:desktop": "pnpm --filter @x-code-cli/desktop build && pnpm --filter @x-code-cli/desktop smoke && pnpm --filter @x-code-cli/desktop smoke:ui",
    "package:desktop": "pnpm --filter @x-code-cli/desktop package:dir",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p packages/core/tests/tsconfig.json && tsc -p packages/cli/tests/tsconfig.json && tsc -p packages/cli/tests/e2e/tsconfig.json && tsc -p packages/desktop/tsconfig.node.json && tsc -p packages/desktop/tsconfig.renderer.json",
    "check:package": "pnpm build && node scripts/check-package-size.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "ci": "pnpm typecheck && pnpm lint:check && pnpm format:check && pnpm test",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "release:desktop": "node scripts/release-desktop.mjs",
    "publish:desktop": "node scripts/publish-desktop-release.mjs",
    "verify:desktop-release": "node scripts/verify-desktop-release.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/yargs": "^17.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
